{
    "enabled": {"description": "启用防护", "type": "bool", "default": true},
    "defense_mode": {
        "description": "防护模式", "type": "string", "default": "sentry",
        "options": ["sentry", "aegis", "scorch", "intercept"],
        "hint": "sentry：加固后继续；aegis：复核后决定是否加固；scorch：替换风险请求，无法隔离则阻断；intercept：停止本轮。"
    },
    "protect_group_chat": {"description": "检测群聊", "type": "bool", "default": true},
    "protect_private_chat": {"description": "检测私聊", "type": "bool", "default": true},
    "scan_extra_text": {"description": "检测本轮额外文本", "type": "bool", "default": true},
    "detect_encoded": {"description": "检查编码文本", "type": "bool", "default": true},
    "anti_harassment_enabled": {"description": "记录不当表达线索", "type": "bool", "default": true},
    "persona_enabled": {
        "description": "启用人设专项检测", "type": "bool", "default": true,
        "hint": "只在明确匹配人设策略时生效，不使用默认人设。"
    },
    "persona_sensitivity": {"description": "人设检测敏感度（0.1–1.0）", "type": "float", "default": 0.7},
    "auto_blacklist": {
        "description": "自动封禁", "type": "bool", "default": false,
        "hint": "仅当替换或阻断路径确认技术注入并实际执行处置时才可生效。"
    },
    "blacklist_duration": {
        "description": "自动封禁时长（分钟）", "type": "int", "default": 60,
        "hint": "0 为永久。"
    },
    "llm_analysis_mode": {
        "description": "模型复核触发方式", "type": "string", "default": "standby",
        "options": ["active", "standby", "disabled"],
        "hint": "active：主动复核；standby：按风险触发；disabled：关闭。sentry 不发起复核。"
    },
    "review_provider": {
        "description": "复核提供商", "type": "string", "default": "", "_special": "select_provider",
        "hint": "留空时按真实会话来源选择。"
    },
    "review_model": {"description": "复核模型", "type": "string", "default": "", "hint": "留空使用所选 Provider 的模型。"},
    "llm_analysis_private_chat_enabled": {"description": "允许私聊模型复核", "type": "bool", "default": false},
    "review_failure_policy": {
        "description": "模型复核失败策略", "type": "string", "default": "graded",
        "options": ["graded", "strict"],
        "hint": "graded：出现可疑证据时阻断；strict：只要需要复核，失败就阻断。"
    },
    "review_timeout_seconds": {"description": "复核超时（秒，1–60）", "type": "int", "default": 10},
    "review_max_concurrency": {"description": "复核并发上限（1–16）", "type": "int", "default": 2},
    "review_max_chars": {"description": "复核输入上限（字符，256–8192）", "type": "int", "default": 4096},
    "gentle_refusal": {"description": "委婉拒绝", "type": "bool", "default": false, "hint": "因注入风险实际阻断时，用当前人格生成一句拒绝；可能产生模型费用。"},
    "refusal_provider": {"description": "拒绝回复提供商", "type": "string", "default": "", "_special": "select_provider", "hint": "留空跟随当前会话。"},
    "refusal_model": {"description": "拒绝回复模型", "type": "string", "default": "", "hint": "默认跟随会话模型；另选提供商后使用该提供商的默认模型。"},
    "incident_history_size": {"description": "诊断记录保留条数（1–5000）", "type": "int", "default": 100}
}
